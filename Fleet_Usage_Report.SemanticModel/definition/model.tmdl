model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-CA
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Fleet_Source","Geo Location","Ministry Key","Model Category Key","Usage Data","Key Measures","Missing Devices","Fleet"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Geo Location'
ref table 'Ministry Key'
ref table 'Model Category Key'
ref table 'Usage Data'
ref table 'Key Measures'
ref table Fleet

ref cultureInfo en-US

